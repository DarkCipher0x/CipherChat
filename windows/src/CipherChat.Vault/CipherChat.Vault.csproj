<Project Sdk="Microsoft.NET.Sdk">
  <!-- What this PC remembers between runs (server, account, the paired device's token), encrypted with DPAPI for this
       Windows account and, when switched on, a second layer whose key only Windows Hello can produce. Never the chat
       passphrase, never private chat keys. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>CipherChat.Vault</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
