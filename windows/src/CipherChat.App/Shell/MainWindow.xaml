<Window x:Class="CipherChat.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CipherChat" Height="820" Width="1280" MinHeight="560" MinWidth="860"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{DynamicResource UiFont}" FontSize="{DynamicResource FsBase}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <DockPanel x:Name="Root">
        <!-- the top bar (WindowFrame.cs): brand, the post-quantum status, the signed-in account,
             Settings and Lock, then the caption buttons. Drag it to move the window; double-click to maximise. -->
        <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ContentControl Template="{StaticResource BrandMark}" Width="18" Height="18" Margin="0,0,10,0" IsTabStop="False" Focusable="False"/>
                    <TextBlock Text="CipherChat" FontWeight="SemiBold" Foreground="{DynamicResource Brand}" VerticalAlignment="Center"/>
                    <TextBlock Text=" by DarkCipher Systems" Foreground="{DynamicResource HeaderMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="Captions" DockPanel.Dock="Right" Orientation="Horizontal"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                ToolTip="ML-KEM-1024 + X25519 · ML-DSA-87 + Ed25519 · AES-256-GCM · TLS with X25519MLKEM768 only">
                        <Ellipse x:Name="PqDot" Width="8" Height="8" Fill="{DynamicResource Unknown}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PqText" Text="self-test…" Foreground="{DynamicResource HeaderMuted}" FontSize="{DynamicResource FsMeta}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="WhoText" Foreground="{DynamicResource HeaderFg}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource FsMeta}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" Visibility="Collapsed" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LockButton" Style="{StaticResource HeaderButton}" Visibility="Collapsed" Click="OnLock" ToolTip="Lock: wipe the keys from memory" AutomationProperties.Name="Lock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Lock" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Host" Focusable="False"/>
    </DockPanel>
</Window>
