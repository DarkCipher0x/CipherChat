<Application x:Class="CipherChat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CipherChat.Ui;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/CipherChat.Ui;component/Themes/Brand.xaml"/>
                <ResourceDictionary Source="Themes/Chat.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
