{
  "name": "commandcentre",
  "prefix": "!cc",
  "mcp": {
    "command": "C:\\Program Files\\DarkCipher Systems\\CommandCentre\\DcxMcp.exe",
    "args": [],
    "timeout_seconds": 200
  },
  "rooms": [],
  "readers": ["*"],
  "operators": [],
  "rate_per_minute": 10,
  "max_reply_chars": 3500,
  "commands": {
    "status":    { "tool": "fleet_status",   "help": "every machine: online, role, OS, CPU, memory, user, locked" },
    "mesh":      { "tool": "mesh_status",    "help": "the mesh: controller on duty and every member" },
    "monitors":  { "tool": "monitors",       "help": "uptime monitors: status, latency, 24 h uptime, certificates" },
    "node":      { "tool": "node_details",   "args": ["node"], "help": "one machine in detail" },
    "inventory": { "tool": "node_inventory", "args": ["node"], "help": "hardware and OS of one machine" },
    "apps":      { "tool": "installed_apps", "args": ["node"], "help": "installed programs on one machine" },
    "workflows": { "tool": "list_workflows", "help": "saved workflows" },
    "runs":      { "tool": "recent_runs",    "args": ["limit:int?"], "help": "recent workflow runs" },
    "audit":     { "tool": "audit_log",      "args": ["limit:int?"], "help": "CommandCentre's audit trail" },
    "unifi":     { "tool": "unifi_devices",  "help": "UniFi gateways, switches and APs" },
    "clients":   { "tool": "unifi_clients",  "help": "clients on the UniFi network" },

    "lock":      { "tool": "lock",           "args": ["targets..."], "action": true, "help": "lock the screen (safe, nothing is lost)" },
    "wake":      { "tool": "wake",           "args": ["targets..."], "action": true, "help": "Wake-on-LAN" },
    "service":   { "tool": "service",        "args": ["op", "name", "targets..."], "action": true, "help": "status/start/stop/restart a service (CommandCentre asks you to approve changes)" },
    "power":     { "tool": "power",          "args": ["op", "targets..."], "action": true, "help": "lock, screen_off, sleep, restart, shutdown... (CommandCentre asks you to approve)" },
    "workflow":  { "tool": "run_workflow",   "args": ["workflow*"], "fixed": { "wait": true }, "action": true, "help": "run a saved workflow (CommandCentre asks you to approve disruptive ones)" }
  }
}
