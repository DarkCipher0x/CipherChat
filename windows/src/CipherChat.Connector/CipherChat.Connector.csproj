<Project Sdk="Microsoft.NET.Sdk">
  <!-- CipherChat Connector: another system (CommandCentre, or anything with an MCP server) in the chat as an add-on.
       Console program; presets in connectors\*.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>CipherChat.Connector</RootNamespace>
    <AssemblyName>CipherChatConnector</AssemblyName>
    <ApplicationIcon>..\CipherChat.App\Assets\cipherchat.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1001;CA2000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CipherChat.Addons\CipherChat.Addons.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="connectors\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="connectors" />
  </ItemGroup>
</Project>
