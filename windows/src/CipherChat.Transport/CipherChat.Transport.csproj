<Project Sdk="Microsoft.NET.Sdk">
  <!-- The only way CipherChat talks to a server: TLS 1.3 with post-quantum hybrid key exchange (X25519MLKEM768) and
       nothing else, plus a minimal HTTP/1.1 client on top. No UI, no chat logic. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CipherChat.Transport</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CipherChat.Transport.Tests" />
  </ItemGroup>
</Project>
