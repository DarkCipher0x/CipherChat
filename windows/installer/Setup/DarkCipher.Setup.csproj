<Project Sdk="Microsoft.NET.Sdk">
  <!-- DarkCipher Setup: the themed setup program (a WiX Burn bootstrapper application) around an app's MSI. TEMPLATE:
       copy installer\Setup into another app and give it its own installer\setup-app.* files (README.md).
       .NET Framework 4.8 on purpose: it is part of every supported Windows, so Setup.exe needs no runtime download. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DarkCipher.Setup</AssemblyName>
    <RootNamespace>DarkCipher.Setup</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <!-- x64 so the engine bridge (mbanative.dll) lands beside the exe -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
