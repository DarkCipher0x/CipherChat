# CipherChat server settings (installed as /etc/cipherchat/cipherchat.env, mode 0640 root:cipherchat).

# The public address people open. Links and the CSRF check use it. Must be https://.
CIPHERCHAT_ORIGIN=https://chat.example.com
# What this server is called (page titles, authenticator app entries, emails)
CIPHERCHAT_NAME=CipherChat
# The owner's username: the chat's trust anchor. Every member compares a safety number with this account.
CIPHERCHAT_OWNER=owner

CIPHERCHAT_STATE_DIR=/var/lib/cipherchat
# The server key (per-user key shares are derived from it). Keep it OUT of database backups and back it up offline:
# without it, every sealed identity is unopenable.
CIPHERCHAT_KEY_FILE=/etc/cipherchat/server.key
CIPHERCHAT_LISTEN=127.0.0.1:8787
CIPHERCHAT_WEB_DIR=/opt/cipherchat/web
# nginx on this machine sets X-Real-IP; only trusted from loopback
CIPHERCHAT_TRUST_PROXY=1

# Optional email (invitation links, notifications). Normally set on the admin page (Settings > Email): these lines are
# only the starting values. TLS always, certificates always verified. Mail is sent by the separate, jailed
# cipherchat-mailer service (CIPHERCHAT_MAILER=separate); the chat server itself stays loopback-only.
# CIPHERCHAT_SMTP_ALLOW_PRIVATE=1 allows an SMTP server on a private or loopback address (off by default).
#CIPHERCHAT_SMTP_HOST=smtp.example.com
#CIPHERCHAT_SMTP_PORT=587
#CIPHERCHAT_SMTP_USER=chat@example.com
#CIPHERCHAT_SMTP_PASSWORD_FILE=/etc/cipherchat/smtp-password
#CIPHERCHAT_MAIL_FROM=chat@example.com
#CIPHERCHAT_ALERT_TO=you@example.com

# Passkeys in the CipherChat Android app: "<package>=<SHA-256 of the app's signing certificate>", comma-separated.
# The server then publishes /.well-known/assetlinks.json and accepts that app's passkey origin (docs/ANDROID.md).
CIPHERCHAT_ANDROID_APPS=
