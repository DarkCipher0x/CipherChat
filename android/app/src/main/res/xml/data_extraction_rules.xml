<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from cloud backup and device-to-device transfer. The vault key is hardware-bound and must never
     leave this device; copying app data to another device would be useless and is disallowed outright. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
