<?xml version="1.0" encoding="UTF-8"?>
<!-- Gradle dependency verification. The cryptography provider is pinned by SHA-256: Gradle refuses to build if the
     downloaded BouncyCastle jar or pom differs from these bytes (both hashes match the SHA-1 and SHA-256 Maven Central
     publishes, checked 2026-10-24). Everything else is trusted by group, like the sibling DarkCipher apps.
     To update: bump the version in libs.versions.toml, verify the new files against Maven Central's checksums,
     read the release notes, then replace the two sha256 values below. -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!org[.]bouncycastle$).*$" regex="true"/>
         <!-- The Android Gradle Plugin's own build classpath uses BouncyCastle 1.79 (signing tools); it is never
              packaged into the app. The app's copy is 1.86 and must match the hashes below. -->
         <trust group="org.bouncycastle" version="1.79" reason="AGP build classpath only, not shipped"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="org.bouncycastle" name="bcprov-jdk18on" version="1.86">
         <artifact name="bcprov-jdk18on-1.86.jar">
            <sha256 value="2af190b300cbb0b35e248ccf5f4a06b6072030aeb3da7a98ec73abe5b4cb371f" origin="Maven Central sha256 + sha1, verified 2026-10-24"/>
         </artifact>
         <artifact name="bcprov-jdk18on-1.86.pom">
            <sha256 value="970b70cb75a184639b6fb9ba3c465aca6a4e1a5f3fff4d65ce8574b2fd79ef38" origin="Maven Central sha1, verified 2026-10-24"/>
         </artifact>
      </component>
      <component group="org.bouncycastle" name="bctls-jdk18on" version="1.86.2">
         <artifact name="bctls-jdk18on-1.86.2.jar">
            <sha256 value="8ce8d5fb1b5d323a73df1fdba920b2f97c12d047986028fe65bf64d3997e50f2" origin="Maven Central sha256 + sha1, verified 2026-10-24"/>
         </artifact>
         <artifact name="bctls-jdk18on-1.86.2.pom">
            <sha256 value="de33bae9ee13547607a5e1240b32bef0838a7e3cea3f9939dae791f3660dc60c" origin="Maven Central sha256 + sha1, verified 2026-10-24"/>
         </artifact>
      </component>
      <component group="org.bouncycastle" name="bcutil-jdk18on" version="1.86">
         <artifact name="bcutil-jdk18on-1.86.jar">
            <sha256 value="1c268e15f785aafb1e4670d8d6e5f856f69475e96c162dadcd1ff9b350e9139f" origin="Maven Central sha256 + sha1, verified 2026-10-24"/>
         </artifact>
         <artifact name="bcutil-jdk18on-1.86.pom">
            <sha256 value="2209b3e5d1eb2bb3c593b824c1b8f142b05dea8e9df7400b0f33f2b91a0741fa" origin="Maven Central sha256 + sha1, verified 2026-10-24"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
